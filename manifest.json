{
  "manifest_version": 3,
  "name": "Usage Monitor",
  "version": "0.2.0",
  "description": "Check your Claude.ai session and weekly usage percentage on demand, with optional Discord/Telegram/Slack alerts.",
  "permissions": ["storage", "alarms", "cookies"],
  "host_permissions": ["https://claude.ai/*", "https://discord.com/*", "https://api.telegram.org/*", "https://hooks.slack.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "dist/background/worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "dist/popup/popup.html",
    "default_title": "Usage Monitor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "dist/options/options.html"
}
